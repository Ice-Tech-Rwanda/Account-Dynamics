# Account Dynamics - Next.js production service
#
# INSTALL (as root):
#   sudo cp deploy/account-dynamics.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now account-dynamics
#
# NOTE: Before first start, create the production env file (see deploy/.env.production)
# and rebuild with the correct public URL:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000 NEXTAUTH_URL=http://localhost:3000 npm run build
# Then edit WorkingDirectory / ExecStart paths to match this machine.

[Unit]
Description=Account Dynamics Next.js (production, port 3000)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Run as a non-root user. Change to match the app owner on this machine.
User=ice-tech-rwanda
Group=ice-tech-rwanda

WorkingDirectory=/mnt/windows_files/Advanced Real World Project/Account-Dynamics

# Load production secrets/overrides. Change path as needed.
# EnvironmentFile=/etc/account-dynamics/env

# Full path to the Node binary (nvm path shown; adjust to this machine).
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_APP_URL=http://localhost:3000
Environment=NEXTAUTH_URL=http://localhost:3000

# Run the compiled Next server via the project's local Next CLI.
# `node_modules/...` is relative and resolved against WorkingDirectory above
# (avoids the space in the app path). Full path to the Node binary, no spaces.
ExecStart=/home/ice-tech-rwanda/.nvm/versions/node/v24.19.0/bin/node \
  node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5

# Hardening. NOTE: the app dir path contains spaces, so ReadWritePaths= cannot be
# used safely; ProtectSystem=full alone keeps /usr, /boot, /etc read-only while the
# app writes to /mnt normally. ProtectHome=full keeps the nvm home read-only.
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
