# Copy this file to .env.local and fill in your values (DO NOT COMMIT .env.local)

# === App ===
# Public base URL used in metadata, sitemap, and client code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Database ===
# SQLite (local development, no server needed):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — Neon, Supabase, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# === Auth ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-string-in-production"
NEXTAUTH_URL=http://localhost:3000

# Optional: used by the e2e admin-login tests
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# === Email (SMTP) ===
# Used by the contact form, newsletter, and notifications.
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""
EMAIL_FROM=""

# === Uploads ===
# Signs protected file URLs; falls back to NEXTAUTH_SECRET when unset.
UPLOADS_SIGNING_SECRET=""

# === Logging ===
LOG_LEVEL=info

# === Optional / future ===
RESOURCE_MAX_UPLOAD_BYTES=5242880
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# WHATSAPP_NUMBER="+250700000000"
