# Copy this file to .env.local and fill in your values (DO NOT COMMIT .env.local)

# === App ===
# Public base URL used in metadata, sitemap, and client code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Database ===
# PostgreSQL is the primary datasource (Prisma provider = "postgresql").
# Local dev container (start once):
#   docker run -d --name account-dynamics-pg -e POSTGRES_USER=accountdynamics \
#     -e POSTGRES_PASSWORD=accountdynamics_local_dev -e POSTGRES_DB=accountdynamics \
#     -p 5433:5432 -v account_dynamics_pg_data:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL="postgresql://accountdynamics:accountdynamics_local_dev@localhost:5433/accountdynamics?schema=public&connection_limit=5&pool_timeout=2&socket_timeout=10&connect_timeout=10"
# Direct connection for the Prisma CLI (generate/migrate/seed) — bypasses any pooler.
DIRECT_URL="postgresql://accountdynamics:accountdynamics_local_dev@localhost:5433/accountdynamics?schema=public"
# Production: use a managed Postgres (Neon, Supabase, RDS) with a pooled connection URL, e.g.:
# DATABASE_URL="postgresql://user:password@host-pooled:5432/dbname?schema=public&connection_limit=5"
# DIRECT_URL="postgresql://user:password@host-direct:5432/dbname?schema=public"

# === Auth ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-string-in-production"
NEXTAUTH_URL=http://localhost:3000

# Optional: used by the e2e admin-login tests.
# The seed refuses the placeholder/weak password in production (see prisma/seed.js).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# === Email ===
# Used by the contact form, newsletter, and notifications.
# Preferred provider: Resend (best for Next.js/Vercel). Set RESEND_API_KEY to enable.
RESEND_API_KEY=""
# EMAIL_FROM must use a domain you have VERIFIED in Resend (see https://resend.com/domains).
# If you don't verify a domain, Resend rejects sends with "550 ... domain is not verified".
# Example once you verify accountdynamics.com:
#   EMAIL_FROM="Account Dynamics <info@accountdynamics.com>"
EMAIL_FROM=""
# Fallback provider: SMTP (used only when RESEND_API_KEY is not set).
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""

# === Uploads ===
# Signs protected file URLs; falls back to NEXTAUTH_SECRET when unset.
UPLOADS_SIGNING_SECRET=""

# Vercel Blob storage token. SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_ and
# never expose to the browser. Get it from Vercel → Storage → Blob. When set,
# uploads go to Vercel Blob; when unset, uploads fall back to the local
# filesystem (public/uploads) for local dev / self-hosted.
# Leave empty for local development (uses the local filesystem).
BLOB_READ_WRITE_TOKEN=""

# === Logging ===
LOG_LEVEL=info

# === Analytics (optional) ===
# Google Analytics 4 measurement id. When set, the GA script loads and the
# production CSP allows googletagmanager/google-analytics. Rebuild after changing.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# === Optional / future ===
RESOURCE_MAX_UPLOAD_BYTES=5242880
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
